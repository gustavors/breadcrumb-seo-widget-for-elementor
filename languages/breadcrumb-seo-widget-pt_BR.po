msgid "Yoast Breadcrumb"
msgstr "Yoast Breadcrumb"

msgid "Rank Math Breadcrumb"
msgstr "Rank Math Breadcrumb"

msgid "Settings"
msgstr "Configurações"

msgid "Hide Current Page?"
msgstr "Ocultar Página Atual?"

msgid "Hides the title of the current page at the end of the breadcrumb."
msgstr "Oculta o título da página atual no final do breadcrumb."

msgid "Yes"
msgstr "Sim"

msgid "No"
msgstr "Não"

msgid "Breadcrumb Styles"
msgstr "Estilos do Breadcrumb"

msgid "Normal Text Color"
msgstr "Cor do Texto Normal"

msgid "Link Color"
msgstr "Cor dos Links"

msgid "Link Color (Hover)"
msgstr "Cor dos Links (Hover)"

msgid "The Yoast SEO plugin must be active and the Breadcrumbs option enabled in the Yoast settings."
msgstr "O plugin Yoast SEO precisa estar ativo e a opção de Breadcrumbs habilitada nas configurações do Yoast."

msgid "The Rank Math SEO plugin must be active and the Breadcrumbs option enabled in the Rank Math settings."
msgstr "O plugin Rank Math SEO precisa estar ativo e a opção de Breadcrumbs habilitada nas configurações do Rank Math."
